---
interface Props {
  title: string;
  publisher: string;
  date: string;
  description: string;
  link: string;
  readLabel: string;
}

const { title, publisher, date, description, link, readLabel } = Astro.props;
---

<article class='miar rounded-xl border border-gray-200/20 bg-gray-900/20 p-5 backdrop-blur-sm'>
  <h3 class='text-xl font-semibold text-sky-300'>{title}</h3>
  <p class='mt-1 text-sm text-gray-400'>
    {publisher} · {date}
  </p>
  <p class='mt-3 text-balance text-gray-200'>{description}</p>
  <a
    href={link}
    target='_blank'
    rel='noopener noreferrer'
    class='mt-4 inline-flex items-center rounded-lg border border-sky-300/40 px-3 py-2 text-sm font-medium text-sky-200 transition hover:bg-sky-300/10 hover:text-sky-100'
  >
    {readLabel}
  </a>
</article>

<style>
  article {
    position: absolute;
    height: 100%;
    overflow: hidden;

    transition: height 0.3s ease, box-shadow 0.3s ease;
    interpolate-size: allow-keywords;

    &:hover {
      height: auto;
      z-index: 10;
      backdrop-filter: blur(15px) brightness(0.3);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.3);

      transform: scale(1.02);
    }
  }

  article::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Shadow bottom gradient */
    background: linear-gradient(to bottom, transparent 50% ,rgba(0,0,0,0.8) 97%, rgba(0,0,0,1) 115%);

    pointer-events: none;
  }

  article:hover::after {
    display: none;
  }
</style>